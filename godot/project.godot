; AEON: God of Pangaea — Godot 4 native port
; Engine configuration file. Open this folder in Godot 4.3+ to run.

config_version=5

[application]

config/name="AEON: God of Pangaea"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/Config.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.08, 1)
anti_aliasing/quality/msaa_3d=1
